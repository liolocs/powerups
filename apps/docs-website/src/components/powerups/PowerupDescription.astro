---
import { Badge } from "@astrojs/starlight/components";
import type { PackageDetail } from "../../scripts/powerup-view/fetch-package-detail.ts";

interface Props {
    detail: PackageDetail;
}

const { detail } = Astro.props;
---

<>
    <p class="pups-view-desc">
        {detail.description || "No description provided"}
    </p>

    <div class="pups-view-badges">
        <Badge text={`v${detail.version}`} size="small" />
        <Badge
            text={detail.license || "license unknown"}
            size="small"
            variant="note"
        />
        {detail.instructions && (
            <Badge text={detail.instructions.type} size="small" variant="tip" />
        )}
        {detail.publisherUsername && (
            <span class="pups-view-publisher">
                by {detail.publisherUsername}
            </span>
        )}
    </div>
</>