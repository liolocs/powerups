{
  "name": "@pwrp/cli",
  "version": "0.0.1",
  "author": "lioloc@pm.me",
  "description": "A system for AI to use existing code rather than come up with it from scratch",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "npm run clean && tsgo && tsup && cp src/app.tsconfig.json lib && mkdir -p lib/private/scaffold/templates && cp src/private/scaffold/templates/*.njk lib/private/scaffold/templates/",
    "clean": "rm -rf ./lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build",
    "test": "npx proby",
    "b:link": "bun run scripts/link.ts",
    "release": "commit-and-tag-version --preset conventionalcommits",
    "release:dry-run": "commit-and-tag-version --preset conventionalcommits --dry-run"
  },
  "type": "module",
  "files": [
    "/lib/bin.js",
    "/lib/bin.js.map",
    "/lib/private/scaffold/**/*.njk",
    "!/**/*.spec.*"
  ],
  "imports": {
    "#*": {
      "@powerups/source": "./src/private/*.ts",
      "default": "./lib/private/*.js"
    }
  },
  "dependencies": {
    "@rcompat/cli": "^0.25.0",
    "@rcompat/error": "^0.9.0",
    "@rcompat/fs": "^0.35.1",
    "@rcompat/io": "^0.11.0",
    "@rcompat/is": "^0.12.0",
    "@rcompat/runtime": "^0.17.0",
    "@rcompat/string": "^0.22.0",
    "@rcompat/type": "^0.18.0",
    "nunjucks": "^3.2.4",
    "pema": "^0.8.2"
  },
  "devDependencies": {
    "@pwrp/program": "workspace:^",
    "@types/nunjucks": "^3.2.6",
    "commit-and-tag-version": "^13.1.2",
    "tsup": "^8.5.1"
  },
  "bin": {
    "pwrp": "./lib/bin.js"
  }
}
