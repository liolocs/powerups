---
import DetailHeader from "@/components/pages/powerups/PowerupDetails/DetailHeader.astro";
import Accordion from "@/components/ui/astro/accordion/Accordion.astro";
import AccordionContent from "@/components/ui/astro/accordion/AccordionContent.astro";
import AccordionItem from "@/components/ui/astro/accordion/AccordionItem.astro";
import AccordionTrigger from "@/components/ui/astro/accordion/AccordionTrigger.astro";
import Badge from "@/components/ui/astro/Badge.astro";
import CodeBlock from "@/components/ui/astro/code-block/CodeBlock.astro";

interface Props {
}
---

<div class="flex flex-col gap-4">
  <DetailHeader>Steps</DetailHeader>

  <Accordion>
    <AccordionItem class="flex flex-col gap-4">
      <AccordionTrigger class="flex w-full items-center gap-4 px-4 no-underline! hover:[&>.accordion-text]:underline! hover:bg-muted/10">
        <div class="flex items-center gap-4 w-full">
          <span class="border border-muted text-muted-foreground size-10 flex items-center justify-center text-lg rounded-md">1</span>
          <span class="accordion-text"><Badge variant="secondary">Create</Badge> index.ts</span>
        </div>
        <Badge variant="default">view template</Badge>
      </AccordionTrigger>
      <AccordionContent class="">
        <CodeBlock code={`import { defineInstructions, type Instructions } from "@liolocs/powerups-sdk";`} language="ts" class="w-full" />
      </AccordionContent>
    </AccordionItem>

    <AccordionItem class="flex flex-col gap-4">
      <AccordionTrigger class="flex w-full items-center gap-4 px-4 no-underline! hover:[&>.accordion-text]:underline! hover:bg-muted/10">
        <div class="flex items-center gap-4 w-full">
          <span class="border border-muted text-muted-foreground size-10 flex items-center justify-center text-lg rounded-md">1</span>
          <span class="accordion-text"><Badge variant="secondary">Install</Badge> 2 packages</span>
        </div>
        <Badge variant="note">view</Badge>
      </AccordionTrigger>
      <AccordionContent class="">
        <CodeBlock code={`import { defineInstructions, type Instructions } from "@liolocs/powerups-sdk";`} language="ts" class="w-full" />
      </AccordionContent>
    </AccordionItem>

    <div class="flex w-full items-center gap-4 px-4 py-6">
      <div class="flex items-center gap-4 w-full text-sm text-muted-foreground">
        <span class="border border-muted text-muted-foreground size-10 flex items-center justify-center text-lg rounded-md">1</span>
        <span class="accordion-text"><Badge variant="secondary">Read</Badge> index.ts and get the variable <Badge variant="secondary">packageName</Badge></span>
      </div>
    </div>

    <div class="flex w-full items-center gap-4 px-4 py-6">
      <div class="flex items-center gap-4 w-full text-sm text-muted-foreground">
        <span class="border border-muted text-muted-foreground size-10 flex items-center justify-center text-lg rounded-md">1</span>
        <span class="accordion-text"><Badge variant="destructive">Delete</Badge> index.ts</span>
      </div>
    </div>
  </Accordion>
</div>