{
  "name": "cli-command",
  "description": "Scaffold a standalone CLI command with flags, action, errors, and spec",
  "variables": {
    "required": [
      "commandName",
      "description",
      "flags",
      "errorCases"
    ]
  },
  "intent": [
    "cli",
    "command",
    "scaffold",
    "generate",
    "standalone"
  ],
  "steps": [
    {
      "type": "create",
      "name": "barrel.ts",
      "template": "barrel.ts.ts",
      "outputPath": "packages/cli/src/commands/{{commandName}}.ts"
    },
    {
      "type": "create",
      "name": "command.ts",
      "template": "command.ts.ts",
      "outputPath": "packages/cli/src/private/commands/{{commandName}}/index.ts"
    },
    {
      "type": "create",
      "name": "errors.ts",
      "template": "errors.ts.ts",
      "outputPath": "packages/cli/src/private/errors/{{commandName}}Errors.ts"
    },
    {
      "type": "create",
      "name": "spec.ts",
      "template": "spec.ts.ts",
      "outputPath": "packages/cli/src/private/commands/{{commandName}}/{{commandName}}.spec.ts"
    }
  ]
}