{
  "name": "@liolocs/powerups-sdk",
  "version": "0.1.0",
  "author": "lioloc@pm.me",
  "description": "SDK for powerups system",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "scripts": {
    "build": "npm run clean && tsgo",
    "clean": "rm -rf ./lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build",
    "test": "npx proby",
    "release": "commit-and-tag-version --preset conventionalcommits --path .",
    "release:dry-run": "commit-and-tag-version --preset conventionalcommits --path . --dry-run"
  },
  "type": "module",
  "files": [
    "/lib/**/*.js",
    "/lib/**/*.d.ts",
    "!/**/*.spec.*"
  ],
  "imports": {
    "#*": {
      "@powerups/source": "./src/private/*.ts",
      "default": "./lib/private/*.js"
    }
  },
  "exports": {
    ".": {
      "@powerups/source": "./src/public/index.ts",
      "default": "./lib/public/index.js"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "commit-and-tag-version": "^13.1.2"
  }
}
