{
  "name": "cli-subcommand",
  "description": "Scaffold a subcommand that attaches to an existing parent command",
  "type": "multi-use",
  "variables": {
    "required": [
      "parentCommand",
      "subcommandName",
      "description",
      "flags",
      "errorCases"
    ]
  },
  "intent": [
    "cli",
    "command",
    "subcommand",
    "scaffold",
    "generate",
    "nested"
  ],
  "steps": [
    {
      "type": "create",
      "name": "subcommand.ts",
      "template": "template/subcommand.ts.ts",
      "outputPath": "packages/cli/src/private/commands/{{parentCommand}}/{{subcommandName}}.ts"
    },
    {
      "type": "create",
      "name": "subcommand-spec.ts",
      "template": "template/subcommand-spec.ts.ts",
      "outputPath": "packages/cli/src/private/commands/{{parentCommand}}/{{subcommandName}}.spec.ts"
    },
    {
      "type": "modify",
      "name": "modify-index",
      "template": "template/modify-index.ts.ts",
      "outputPath": "packages/cli/src/private/commands/{{parentCommand}}/index.ts"
    },
    {
      "type": "modify",
      "name": "modify-errors",
      "template": "template/modify-errors.ts.ts",
      "outputPath": "packages/cli/src/private/errors/{{parentCommand}}Errors.ts"
    }
  ]
}