---
import { MagnifyingGlassIcon } from "@phosphor-icons/react";
import InputGroup from "@/components/ui/astro/input-group/InputGroup.astro";
import InputGroupInput from "@/components/ui/astro/input-group/InputGroupInput.astro";
import InputGroupAddon from "@/components/ui/astro/input-group/InputGroupAddon.astro";
---

<InputGroup class="w-full">
  <InputGroupInput id="powerups-search" placeholder="Search..." />
  <InputGroupAddon>
    <MagnifyingGlassIcon />
  </InputGroupAddon>
  <InputGroupAddon align="inline-end">
  </InputGroupAddon>
</InputGroup>

<div id="powerups-results-count" class="text-sm text-muted-foreground mt-2">
  <!-- Updated by client-side script -->
</div>