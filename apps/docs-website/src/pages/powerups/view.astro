---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage frontmatter={{ title: "Powerup" }}>
  <div class="pups-view" data-view>
    <a class="pups-back-link" href="/powerups/">← All powerups</a>
    <div data-view-content></div>
  </div>
</StarlightPage>

<style is:global>
  .pups-back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .pups-back-link:hover { color: var(--sl-color-white); }

  .pups-view-header { margin-bottom: 1.5rem; }

  .pups-view-name {
    margin: 0 0 0.25rem;
    font-size: 1.5rem;
    overflow-wrap: anywhere;
  }

  .pups-view-description { margin: 0 0 0.75rem; color: var(--sl-color-gray-2); }

  .pups-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.9rem; }

  .pups-chip {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
  }

  .pups-install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.55rem 0.9rem;
    background: var(--sl-color-gray-6);
    margin-bottom: 0.9rem;
  }

  .pups-install code {
    flex: 1;
    overflow-wrap: anywhere;
    font-family: var(--sl-font-monospace);
    font-size: 0.85rem;
    color: var(--sl-color-white);
  }

  .pups-copy-button {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
  }

  .pups-view-links { display: flex; gap: 0.6rem; }

  .pups-view-links a {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    padding: 0.15rem 0.6rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .pups-view-links a:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
  }

  .pups-section { margin-bottom: 1.5rem; }

  .pups-section-title {
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
  }

  .pups-muted { color: var(--sl-color-gray-3); }

  .pups-variable-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
  }

  .pups-variable-list li { margin-bottom: 0.25rem; }

  .pups-step {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.55rem 0.8rem;
    margin-bottom: 0.5rem;
  }

  .pups-badge {
    border-radius: 0.35rem;
    padding: 0.1rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--sl-color-bg);
  }

  .pups-badge-create { background: #2e9e5b; }
  .pups-badge-modify { background: #d97706; }
  .pups-badge-delete { background: #dc2626; }
  .pups-badge-read { background: #64748b; }
  .pups-badge-install { background: #6366f1; }
  .pups-badge-unknown { background: var(--sl-color-gray-4); }

  .pups-step-path {
    font-family: var(--sl-font-monospace);
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }

  .pups-tabs { display: flex; flex-wrap: wrap; gap: 0.3rem; }

  .pups-tab {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem 0.4rem 0 0;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-3);
    padding: 0.3rem 0.8rem;
    font-family: var(--sl-font-monospace);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .pups-tab[aria-selected="true"] {
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .pups-code-block {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--sl-font-monospace);
    font-size: 0.8rem;
    line-height: 1.5;
  }
</style>
