---
import { Badge } from "@astrojs/starlight/components";
import type { PowerupStep } from "../../scripts/powerup-view/fetch-package-detail.ts";

const stepBadgeVariant: Record<
    string,
    "success" | "caution" | "danger" | "note" | "tip"
> = {
    create: "success",
    modify: "caution",
    delete: "danger",
    read: "note",
    install: "tip",
};

function stepFile(step: PowerupStep): string {
    switch (step.type) {
        case "create":
        case "modify":
        case "delete":
            return step.outputPath;
        case "read":
            return step.path;
        case "install":
            return (
                [
                    ...(step.dependencies ?? []),
                    ...(step.devDependencies ?? []),
                ].join(", ") || "no dependencies"
            );
    }
}

function stepTemplate(step: PowerupStep): string {
    switch (step.type) {
        case "create":
        case "modify":
            return `Template: ${step.template}`;
        case "delete":
            return "";
        case "read":
            return `Variable: ${step.as}`;
        case "install":
            return "";
    }
}

interface Props {
    step: PowerupStep;
}

const { step } = Astro.props;
const variant = stepBadgeVariant[step.type] ?? "note";
---

<div class="flex flex-col gap-2">
    <div class="flex gap-2 justify-between">
        <div class="flex gap-2">
            <Badge
                class="w-16"
                text={step.type}
                variant={variant}
                size="small"
            />
            <span class="">{stepFile(step)}</span>
        </div>
        <div class="text-xs flex items-center text-gray-500">
            {stepTemplate(step)}
        </div>
    </div>
</div>
