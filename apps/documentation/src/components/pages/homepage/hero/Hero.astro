---
import { buttonVariants } from "@/components/ui/button"
import { ArrowRightIcon } from "@phosphor-icons/react"

---

<div class="flex flex-col items-center justify-center gap-4 p-24 text-center">
  <h1 class="font-semibold text-3xl md:text-5xl text-foreground">Powerups</h1>
  <p class="text-lg">Reusable instructions for your AI agent for better output.</p>

  <a class={buttonVariants({ variant: "default" })} href="/guides/">
    Get started
    <ArrowRightIcon className="ml-2 h-4 w-4" />
  </a>
</div>