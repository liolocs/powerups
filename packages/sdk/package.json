{
  "name": "@liolocs/powerups-sdk",
  "version": "1.1.0",
  "author": "lioloc@pm.me",
  "description": "SDK for powerups system",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liolocs/powerups",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "npm run clean && tsgo",
    "clean": "rm -rf ./lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "schema": "bun run --conditions @powerups/source scripts/build-preview-schema.ts",
    "prepublishOnly": "npm run build",
    "test": "npx proby",
    "release": "npm run schema && git add preview.schema.json && commit-and-tag-version --preset conventionalcommits --path . --commit-all",
    "release:dry-run": "commit-and-tag-version --preset conventionalcommits --path . --dry-run"
  },
  "type": "module",
  "files": [
    "/lib/**/*.js",
    "/lib/**/*.d.ts",
    "/preview.schema.json",
    "!/**/*.spec.*"
  ],
  "imports": {
    "#*": {
      "@powerups/source": "./src/private/*.ts",
      "default": "./lib/private/*.js"
    }
  },
  "exports": {
    ".": {
      "@powerups/source": "./src/public/index.ts",
      "default": "./lib/public/index.js"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "commit-and-tag-version": "^13.1.2"
  }
}
