{
  "name": "@dryai/dry-cli",
  "version": "0.0.1",
  "author": "lioloc@pm.me",
  "description": "CLI for dryai",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "npm run clean && tsgo && cp src/app.tsconfig.json lib && cp src/private/scaffold/*.njk lib/private/scaffold/",
    "clean": "rm -rf ./lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build",
    "test": "npx proby"
  },
  "type": "module",
  "files": [
    "/lib/**/*.js",
    "/lib/**/*.d.ts",
    "/lib/private/scaffold/*.njk",
    "!/**/*.spec.*"
  ],
  "imports": {
    "#*": {
      "@dryai/source": "./src/private/*.ts",
      "default": "./lib/private/*.js"
    }
  },
  "exports": {
    ".": {
      "@dryai/source": "./src/public/index.ts",
      "default": "./lib/public/index.js"
    }
  },
  "dependencies": {
    "@dryai/program": "workspace:^",
    "@rcompat/cli": "^0.25.0",
    "@rcompat/error": "^0.9.0",
    "@rcompat/fs": "^0.35.1",
    "@rcompat/io": "^0.11.0",
    "@rcompat/is": "^0.12.0",
    "@rcompat/runtime": "^0.17.0",
    "nunjucks": "^3.2.4",
    "pema": "^0.8.2"
  },
  "devDependencies": {
    "@types/nunjucks": "^3.2.6"
  },
  "bin": {
    "saved": "./lib/bin.js"
  }
}
