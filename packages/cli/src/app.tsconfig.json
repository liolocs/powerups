{
  "compilerOptions": {
    "allowJs": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "types": [
      "primate"
    ]
  },
  "exclude": [
    "${configDir}/scripts/**/*"
  ]
}
