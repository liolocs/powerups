---
import type { PackageDetail } from "../../scripts/powerup-view/fetch-package-detail.ts";
import { buttonVariants } from "@/components/ui/button";
import { ArrowSquareOutIcon } from "@phosphor-icons/react";
interface Props {
    detail: PackageDetail;
}

const { detail } = Astro.props;

const fixedRepositoryUrl = detail.repositoryUrl?.replace(
    /^git\+https:/,
    "https:",
);
---

{
    (detail.npmUrl || detail.repositoryUrl) && (
        <div class="flex items-center gap-4">
            <a
                href={detail.npmUrl}
                class={buttonVariants({ variant: "outline" })}
                target="_blank"
            >
                <ArrowSquareOutIcon size={16} />
                npm
            </a>
            {detail.repositoryUrl && (
                <a
                    href={fixedRepositoryUrl}
                    class={buttonVariants({ variant: "outline" })}
                    target="_blank"
                >
                    <ArrowSquareOutIcon size={16} />
                    repo
                </a>
            )}
        </div>
    )
}
