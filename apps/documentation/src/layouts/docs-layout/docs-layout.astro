---
import Layout from "@/layouts/main.astro"
import Sidebar from "@/layouts/docs-layout/sidebar.astro";
import TableOfContents from "@/layouts/docs-layout/TableOfContents.astro";

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props;
---

<Layout>
  <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr]">
    <Sidebar />
    <main class="h-full w-full grid grid-cols-1 xl:grid-cols-[1fr_auto]">
      <TableOfContents headings={headings} />
      <div class="flex flex-col items-center py-6 xl:py-14 px-16 xl:px-4 h-full w-full xl:order-1 md:max-w-[70vw] xl:max-w-full m-auto ">
        <slot />
      </div>
    </main>
  </div>
</Layout>