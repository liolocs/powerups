---
export const prerender = false;

import { getLiveCollection } from "astro:content";
import type { LiveDataCollectionResult } from "astro";
import PageHeader from "@/components/pages/PageHeader.astro";
import Layout from "@/layouts/main.astro"
import SearchPowerups from "@/components/pages/powerups/SearchPowerups.astro";
import PowerupCard from "@/components/pages/powerups/PowerupCard.astro";
import type { PowerupsPackageData } from "@/loaders/npm-powerups-loader";
import SortPowerupsDropdown from "@/components/pages/powerups/SortPowerupsDropdown.astro";

const title = "Powerups";
const description = "Powerups are reusable packages your AI agent installs instead of writing code from scratch. Browse the directory, then install with `pup install <name>.`";

// Fetch live npm packages matching the `powerups-package` keyword at request time
const { entries, error }: LiveDataCollectionResult<PowerupsPackageData, Error> =
	await getLiveCollection("powerups");

if (error) {
	console.error("[powerups] live collection loader error:", error.message);
} else {
	console.log("[powerups] live collection entries:", entries);
}
---

<Layout>
  <div class="flex flex-col items-center py-6 xl:py-14 px-8 h-full w-full md:max-w-[80vw] m-auto">
      <div class="powerups-page w-full mb-4">
        <PageHeader title={title} description={description} />
      </div>

      <div class="flex flex-col w-full">
        <div class="flex flex-col md:flex-row gap-3">
          <div class="w-full">
            <SearchPowerups />
          </div>
          <div class="min-w-[180px]">
            <SortPowerupsDropdown />
          </div>
        </div>

        <div id="powerups-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mt-8">
          {entries?.map((entry) => (
            <PowerupCard
              name={entry?.data?.name}
              description={entry?.data?.description}
              keywords={entry?.data?.keywords}
              publisher={entry?.data?.publisher}
              downloads={entry?.data?.downloads}
              version={entry?.data?.version}
              date={entry?.data?.date}
              url={`/powerups/${entry?.data?.name}`}
            />
          ))}
        </div>

        <div id="powerups-no-results" class="hidden text-center text-muted-foreground py-8">
          No powerups match your search.
        </div>
      </div>
  </div>

  <script>
    const searchInput = document.getElementById("powerups-search") as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>("[data-search]");
    const resultsCount = document.getElementById("powerups-results-count");
    const noResults = document.getElementById("powerups-no-results");

    const totalCards = cards.length;

    function updateResultsCount(visible: number) {
      if (resultsCount) {
        resultsCount.textContent = `Showing ${visible} of ${totalCards}`;
      }
    }

    function showAllCards() {
      cards.forEach((card) => card.classList.remove("hidden"));
    }

    function filterCards(query: string) {
      let visible = 0;
      cards.forEach((card) => {
        const searchText = card.dataset.search ?? "";
        if (searchText.includes(query)) {
          card.classList.remove("hidden");
          visible++;
        } else {
          card.classList.add("hidden");
        }
      });
      return visible;
    }

    // Initialize results count on load
    updateResultsCount(totalCards);

    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const query = searchInput.value.trim().toLowerCase();

        if (query.length < 2) {
          // Below threshold: show everything, hide no-results
          showAllCards();
          updateResultsCount(totalCards);
          noResults?.classList.add("hidden");
          return;
        }

        const visible = filterCards(query);
        updateResultsCount(visible);

        if (visible === 0) {
          noResults?.classList.remove("hidden");
        } else {
          noResults?.classList.add("hidden");
        }
      });
    }

    // --- Sort logic ---
    const sortSelect = document.getElementById("powerups-sort") as HTMLSelectElement | null;
    const grid = document.getElementById("powerups-grid");

    function sortCards() {
      if (!sortSelect || !grid) return;

      const value = sortSelect.value;
      const cardArray = Array.from(grid.querySelectorAll<HTMLElement>("[data-search]"));

      cardArray.sort((a, b) => {
        if (value === "most-downloads") {
          const aVal = Number(a.dataset.downloads ?? 0) || 0;
          const bVal = Number(b.dataset.downloads ?? 0) || 0;
          return bVal - aVal;
        }

        if (value === "recently-published") {
          const aVal = Number(a.dataset.date ?? 0) || 0;
          const bVal = Number(b.dataset.date ?? 0) || 0;
          return bVal - aVal;
        }

        if (value === "asc") {
          return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
        }

        if (value === "desc") {
          return (b.dataset.name ?? "").localeCompare(a.dataset.name ?? "");
        }

        return 0;
      });

      cardArray.forEach((card) => grid.appendChild(card));
    }

    sortCards();

    if (sortSelect) {
      sortSelect.addEventListener("change", sortCards);
    }
  </script>
</Layout>

<style>
  @reference "tailwindcss";
  h1 {
    @apply mb-3;
  }
</style>