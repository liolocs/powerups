---
import { cva, type VariantProps } from "class-variance-authority"
import type { HTMLAttributes } from "astro/types"
import { cn } from "cn"

const emptyMediaVariants = cva(
  "mb-2 flex shrink-0 items-center justify-center [&_svg]:pointer-events-none [&_svg]:shrink-0",
  {
    variants: {
      variant: {
        default: "bg-transparent",
        icon:
          "flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&_svg:not([class*='size-'])]:size-6",
      },
    },
    defaultVariants: {
      variant: "default",
    },
  }
)

type EmptyMediaVariant = VariantProps<typeof emptyMediaVariants>["variant"]

interface Props extends HTMLAttributes<"div"> {
  class?: string
  variant?: EmptyMediaVariant
}

const { class: className, variant = "default", ...props } = Astro.props

export { emptyMediaVariants }
---

<div
  data-slot="empty-icon"
  data-variant={variant}
  class={cn(emptyMediaVariants({ variant, className }))}
  {...props}
>
  <slot />
</div>