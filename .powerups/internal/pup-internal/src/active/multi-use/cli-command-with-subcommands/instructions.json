{
  "name": "cli-command-with-subcommands",
  "description": "Scaffold a parent command with requiresSubcommand and its first subcommand together",
  "variables": {
    "required": [
      "commandName",
      "description",
      "subcommandName",
      "subcommandDescription",
      "subcommandFlags",
      "subcommandErrorCases"
    ],
    "optional": [
      "errorCases"
    ]
  },
  "intent": [
    "cli",
    "command",
    "subcommand",
    "parent",
    "scaffold",
    "generate",
    "combined"
  ],
  "steps": [
    {
      "type": "create",
      "name": "parent-command.ts",
      "template": "parent-command.ts.ts",
      "outputPath": "packages/cli/src/private/commands/{{commandName}}/index.ts"
    },
    {
      "type": "include",
      "name": "cli-command",
      "variables": {
        "commandName": "{{commandName}}",
        "description": "{{description}}",
        "flags": "[]",
        "errorCases": "{{errorCases}}"
      },
      "excludeSteps": [
        "command.ts",
        "spec.ts"
      ]
    },
    {
      "type": "include",
      "name": "cli-subcommand",
      "variables": {
        "parentCommand": "{{commandName}}",
        "subcommandName": "{{subcommandName}}",
        "description": "{{subcommandDescription}}",
        "flags": "{{subcommandFlags}}",
        "errorCases": "{{subcommandErrorCases}}"
      },
      "excludeSteps": [
        "modify-index"
      ]
    }
  ]
}