{
  "name": "@liolocs/monorepo",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "author": "lioloc@pm.me",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "local": "pnpm run build:packages && bun run packages/cli/scripts/link.ts",
    "upgrade": "pnpm -r update -i -L",
    "build:packages": "pnpm -r --filter='./packages/**' build",
    "build:apps": "pnpm -r --filter='./apps/**' build",
    "readme": "bun run scripts/generate-root-readme.ts",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release:cli": "pnpm -r --filter='./packages/cli' release",
    "publish:cli": "pnpm --filter @liolocs/powerups-cli publish --access public"
  },
  "devDependencies": {
    "@types/nunjucks": "^3.2.6",
    "apekit": "0.0.58",
    "eslint": "^10.5.0",
    "knip": "^6.20.0",
    "nunjucks": "^3.2.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@rcompat/test": "^0.20.0",
    "@types/node": "^25.9.3",
    "@typescript/native-preview": "7.0.0-dev.20260615.1",
    "proby": "^0.22.0"
  }
}