---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import {GITHUB_REPO_URL} from "astro:env/client"
---

<div class="flex flex-col gap-2 text-sm text-foreground/70 text-center mb-3">
