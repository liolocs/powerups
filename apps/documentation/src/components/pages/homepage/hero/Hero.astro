---
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils";
import { ArrowRightIcon } from "@phosphor-icons/react"

---

<div class="flex flex-col items-center justify-center gap-4 p-24 pb-8 text-center">
  <img src="/favicon.svg" alt="Powerups logo" class="size-32" />
  <h1 class="font-semibold text-3xl md:text-5xl text-foreground mb-2">Powerups</h1>
  <p class="text-lg mb-2">Reusable instructions for your AI agent for faster and cheaper output.</p>

  <a class={cn(buttonVariants({ variant: "default", size: "lg" }), "bg-[#8800FE] hover:bg-[#6700c3] text-white rounded-full p-4")} href="/docs/guides/install">
    Get started
    <ArrowRightIcon className="ml-2 h-4 w-4" />
  </a>
</div>