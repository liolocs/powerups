---
export const prerender = false;

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import {
  LinkButton,
  Badge,
  Aside,
  Steps,
  Tabs,
  TabItem,
} from "@astrojs/starlight/components";
import {
  collectTemplatePaths,
  fetchPackageDetail,
  resolveTemplateContent,
  type PackageDetail,
  type PowerupStep,
} from "../../scripts/powerup-view/fetch-package-detail.ts";

// On-demand rendered — the package name comes from the URL path, not getStaticPaths.
// The npm + unpkg fetches run on every request via the Cloudflare Worker.
const name = Astro.params.package;

if (typeof name !== "string" || name.trim() === "") {
  return Astro.redirect("/powerups/");
}

let detail: PackageDetail | null = null;
let fetchError: string | null = null;

try {
  detail = await fetchPackageDetail({ packageName: name });
} catch (e) {
  fetchError = e instanceof Error ? e.message : "Unknown error";
}

const stepBadgeVariant: Record<string, "success" | "caution" | "danger" | "note" | "tip"> = {
  create: "success",
  modify: "caution",
  delete: "danger",
  read: "note",
  install: "tip",
};

function stepTarget(step: PowerupStep): string {
  switch (step.type) {
    case "create":
    case "modify":
      return `${step.outputPath} (from ${step.template})`;
    case "delete":
      return step.outputPath;
    case "read":
      return `${step.path} as "${step.as}"`;
    case "install":
      return [...(step.dependencies ?? []), ...(step.devDependencies ?? [])].join(", ") || "no dependencies";
  }
}

const templatePaths = detail?.instructions ? collectTemplatePaths({ instructions: detail.instructions }) : [];
const installCommand = detail ? `pup install ${detail.name}` : "";
---

<StarlightPage frontmatter={{ title: detail?.name ?? "Powerup" }}>
  {fetchError ? (
    <Aside type="danger" title="Could not load this powerup">
      <p>{fetchError}</p>
      <p>Check your connection and try again, or <LinkButton href="/powerups/" variant="minimal">browse the directory</LinkButton>.</p>
    </Aside>
  ) : detail ? (
    <div class="pups-view not-content">
      <LinkButton href="/powerups/" variant="minimal" icon="left-arrow" iconPlacement="start">
        All powerups
      </LinkButton>

      <p class="pups-view-desc">{detail.description || "No description provided"}</p>

      <div class="pups-view-badges">
        <Badge text={`v${detail.version}`} size="small" />
        <Badge text={detail.license || "license unknown"} size="small" variant="note" />
        {detail.instructions && (
          <Badge text={detail.instructions.type} size="small" variant="tip" />
        )}
        {detail.publisherUsername && (
          <span class="pups-view-publisher">by {detail.publisherUsername}</span>
        )}
      </div>

      <div class="pups-install">
        <pre class="pups-code pups-code-install"><code>{installCommand}</code></pre>
        <button type="button" class="pups-copy" data-copy={installCommand}>Copy</button>
      </div>

      {(detail.npmUrl || detail.repositoryUrl) && (
        <div class="pups-view-links">
          <LinkButton href={detail.npmUrl} variant="secondary" icon="external" iconPlacement="start">
            npm
          </LinkButton>
          {detail.repositoryUrl && (
            <LinkButton href={detail.repositoryUrl} variant="secondary" icon="external" iconPlacement="start">
              Repository
            </LinkButton>
          )}
        </div>
      )}

      {detail.instructions === null ? (
        <Aside type="note" title="No viewable instructions">
          This powerup hasn't published viewable instructions in its package.
        </Aside>
      ) : (
        <>
          <section class="pups-section">
            <h2>Variables</h2>
            {(() => {
              const { required, optional, defaults } = detail.instructions!.variables;
              const hasAny = required.length > 0 || (optional?.length ?? 0) > 0;
              if (!hasAny) return <p class="pups-muted">No variables required.</p>;
              return (
                <ul class="pups-variable-list">
                  {required.map((v) => (
                    <li><code>{v}</code> <span class="pups-muted">(required)</span></li>
                  ))}
                  {(optional ?? []).map((v) => {
                    const def = defaults?.[v];
                    return (
                      <li>
                        <code>{v}</code> <span class="pups-muted">(optional{def !== undefined ? `, default: ${def}` : ""})</span>
                      </li>
                    );
                  })}
                </ul>
              );
            })()}
          </section>

          {detail.instructions.intent.length > 0 && (
            <section class="pups-section">
              <h2>Intent</h2>
              <ul class="pups-variable-list">
                {detail.instructions.intent.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </section>
          )}

          <section class="pups-section">
            <h2>Steps</h2>
            <Steps>
              <ol>
                {detail.instructions.steps.map((step) => (
                  <li>
                    <Badge text={step.type} variant={stepBadgeVariant[step.type] ?? "note"} size="small" />
                    <strong>{step.name}</strong>
                    <br />
                    <code class="pups-step-target">{stepTarget(step)}</code>
                  </li>
                ))}
              </ol>
            </Steps>
          </section>

          {templatePaths.length > 0 && (
            <section class="pups-section">
              <h2>Template files</h2>
              <Tabs>
                {templatePaths.map((path) => {
                  const content = resolveTemplateContent({ templateFiles: detail!.templateFiles, templatePath: path });
                  return (
                    <TabItem label={path}>
                      {content ? (
                        <pre class="pups-code"><code>{content}</code></pre>
                      ) : (
                        <Aside type="caution" title="File not found">
                          This template file was not found in the published package.
                        </Aside>
                      )}
                    </TabItem>
                  );
                })}
              </Tabs>
            </section>
          )}
        </>
      )}
    </div>
  ) : null}
</StarlightPage>

<script>
  // Copy-to-clipboard for the install command.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = "Copy"; }, 1500);
      } catch {
        // clipboard API may be unavailable in non-secure contexts
      }
    });
  });
</script>

<style is:global>
  .pups-view { margin-top: 1rem; }

  .pups-view-desc {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
    margin: 1rem 0 0.75rem;
    line-height: 1.5;
  }

  .pups-view-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .pups-view-publisher {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .pups-install {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-bottom: 1rem;
  }

  .pups-code {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    padding: 0.75rem 1rem;
    overflow-x: auto;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .pups-code-install {
    flex: 1;
    border-radius: 0.5rem 0 0 0.5rem;
    border-right: none;
  }

  .pups-code code {
    font-family: inherit;
    color: inherit;
    background: none;
  }

  .pups-copy {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0 0.5rem 0.5rem 0;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0 1rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .pups-copy:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
  }

  .pups-view-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .pups-section { margin-bottom: 2rem; }
  .pups-section h2 {
    font-size: var(--sl-text-h4);
    margin: 0 0 0.75rem;
  }

  .pups-muted { color: var(--sl-color-gray-3); }

  .pups-variable-list {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.8;
  }
  .pups-variable-list code {
    font-family: var(--sl-font-mono);
    font-size: 0.85em;
    color: var(--sl-color-white);
  }

  .pups-step-target {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }
</style>