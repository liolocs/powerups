---
import { cn } from "cn"

interface Props {
  class?: string
}

const { class: className, ...props } = Astro.props
---

<!-- <summary> is the native toggle for <details>. We reset the default
     disclosure marker/cursor so it can be styled like a button. -->
<summary
  data-slot="collapsible-trigger"
  class={cn(
    "cursor-pointer select-none list-none outline-hidden [&::-webkit-details-marker]:hidden",
    className
  )}
  {...props}
>
  <slot />
</summary>