---
import { buttonVariants } from '@/components/ui/button';
import {ArrowLeftIcon, ArrowRightIcon} from "@phosphor-icons/react";

interface Props {
  title: string;
  description: string;
  backHref?: string;
  forwardHref?: string;
}

const { title, description, backHref, forwardHref } = Astro.props;
---
<div class="flex justify-between w-full">
  <div class="flex flex-col">
    <h1 class="text-3xl font-semibold tracking-tight leading-9 w-full">{title}</h1>
    <p class="text-base leading-7 text-muted-foreground mb-8 w-full">{description}</p>
  </div>

  <div class="flex gap-2">
    {backHref && 
    <a class={buttonVariants({ variant: "secondary" })} href={backHref}>
      <ArrowLeftIcon className="size-4"></ArrowLeftIcon>
    </a>
    }
    {forwardHref &&
    <a class={buttonVariants({ variant: "secondary" })} href={forwardHref}>
      <ArrowRightIcon className="size-4"></ArrowRightIcon>
      </a>
      }
  </div>
</div>