---
import { Button, buttonVariants } from "@/components/ui/button"
import Search from "@/components/header/Search.astro";
import { GithubLogoIcon } from "@phosphor-icons/react";
import { ModeToggle } from "@/components/general/ModeToggle";
import HeaderDrawer from "@/components/header/Drawer.tsx";
import { buildDocsNav } from "@/layouts/docs-layout/buildDocsNav";
import { buildTopLinks } from "@/config/site-nav";
const githubUrl = import.meta.env.GITHUB_REPO_URL;

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);

// Site nav from the `docs` collection (top-level folders -> first page) plus
// manually-declared standalone pages (see src/config/site-nav.ts).
const navMain = await buildDocsNav(currentPath);
const topLinks = buildTopLinks(navMain);

// Mobile drawer sections: each top-level folder becomes a section; its direct
// children (pages and sub-folders) become flat links (no collapsibles on mobile).
const sectionLinks = navMain.flatMap((node) =>
  node.kind === "folder"
    ? [{
        title: node.title,
        links: node.children.map((child) => ({
          label: child.title,
          href: child.url,
        })),
      }]
    : [],
);
---

<header class="flex items-center md:justify-between p-2 gap-2" style="height: var(--header-height);">
  <div class="flex items-center md:w-full gap-2">
    <div class="lg:hidden">
      <HeaderDrawer client:load topLinks={topLinks} sectionLinks={sectionLinks} />
    </div>
    <div class="hidden lg:flex font-semibold px-4">powerups.dev</div>

    <div class="hidden md:flex space-x-2">
      {topLinks.map((link) => (
        <a class={buttonVariants({ variant: "ghost" })} href={link.href} target={link.target} rel={link.target === "_blank" ? "noreferrer" : undefined}>
          {link.label}
        </a>
      ))}
    </div>
  </div>


  <div class="flex w-full justify-end">
    <div class="w-full md:max-w-[200px]">
      <Search></Search>
    </div>

    <a class={buttonVariants({ variant: "ghost" })} href={githubUrl} target="_blank">
      <GithubLogoIcon client:load className="size-5"/>
    </a>

    <ModeToggle client:load />
  </div>
</header>