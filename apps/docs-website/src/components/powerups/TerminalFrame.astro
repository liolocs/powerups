---
import { highlightCode } from "../../scripts/powerup-view/highlight.ts";

interface Props {
    /** The command to display in the terminal. */
    command: string;
}

const { command } = Astro.props;
const highlighted = highlightCode(command, "bash");
---

<figure class="pups-frame">
    <div class="pups-frame-header">
        <span class="pups-terminal-dots" aria-hidden="true"></span>
        <span class="sr-only">Terminal window</span>
    </div>
    <div class="pups-code-wrap">
        <pre class="pups-code"><code set:html={highlighted} /></pre>
        <button
            type="button"
            class="pups-copy"
            data-copy={command}
            aria-label="Copy command"
        >
            <span class="pups-copy-feedback">Copied!</span>
        </button>
    </div>
</figure>