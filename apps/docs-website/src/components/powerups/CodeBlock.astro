---
import {
    highlightCode,
    detectLang,
} from "../../scripts/powerup-view/highlight.ts";

interface Props {
    /** Raw source code to syntax-highlight. */
    code: string;
    /** Explicit language, or a file path to auto-detect from. */
    lang?: string;
    path?: string;
    /** Extra class names on the <pre> element. */
    class?: string;
}

const { code, lang, path, class: className } = Astro.props;
const language = lang ?? (path ? detectLang(path) : "typescript");
const highlighted = highlightCode(code, language);
const classes = ["pups-code"];
if (className) classes.push(className);
---

<pre class={classes.join(" ")}><code set:html={highlighted} /></pre>

<style>
    .pups-code,
    .pups-code-standalone {
        box-shadow: none !important;
        padding: 0 !important;
    }
</style>
