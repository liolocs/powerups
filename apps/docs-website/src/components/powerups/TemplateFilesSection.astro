---
import { Tabs, TabItem, Aside } from "@astrojs/starlight/components";
import {
    collectTemplatePaths,
    resolveTemplateContent,
    type PackageDetail,
} from "../../scripts/powerup-view/fetch-package-detail.ts";
import TitleAndDescription from "./TitleAndDescription.astro";
import CodeBlock from "./CodeBlock.astro";

interface Props {
    detail: PackageDetail;
}

const { detail } = Astro.props;
const templatePaths = collectTemplatePaths({
    instructions: detail.instructions!,
});
---

{templatePaths.length > 0 && (
    <section class="pups-section">
        <TitleAndDescription title="Template files" />
        <Tabs>
            {templatePaths.map((path) => {
                const content = resolveTemplateContent({
                    templateFiles: detail.templateFiles,
                    templatePath: path,
                });
                return (
                    <TabItem label={path}>
                        {content ? (
                            <CodeBlock code={content} path={path} class="pups-code-standalone" />
                        ) : (
                            <Aside type="caution" title="File not found">
                                This template file was not found in the
                                published package.
                            </Aside>
                        )}
                    </TabItem>
                );
            })}
        </Tabs>
    </section>
)}