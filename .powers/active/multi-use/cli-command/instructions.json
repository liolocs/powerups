{
  "name": "cli-command",
  "description": "Scaffolds a new CLI command with entry, impl, errors, and spec files.",
  "variables": {
    "required": [
      "name",
      "description"
    ]
  },
  "intent": [
    "cli command",
    "new command",
    "powers cli"
  ],
  "output": {
    "create": [
      {
        "name": "entry",
        "template": "command-entry.ts.ts",
        "outputPath": "packages/cli/src/commands/{{name}}.ts"
      },
      {
        "name": "impl",
        "template": "command-impl-index.ts.ts",
        "outputPath": "packages/cli/src/private/commands/{{name}}/index.ts"
      },
      {
        "name": "errors",
        "template": "command-errors.ts.ts",
        "outputPath": "packages/cli/src/private/errors/{{name}}Errors.ts"
      },
      {
        "name": "spec",
        "template": "command-spec.ts.ts",
        "outputPath": "packages/cli/src/private/commands/{{name}}/{{name}}.spec.ts"
      }
    ],
    "modify": [],
    "delete": []
  }
}