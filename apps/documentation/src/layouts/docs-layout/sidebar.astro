---
import SidebarMenu from "@/layouts/docs-layout/SidebarMenu.astro"
import SidebarMenuItem from "@/layouts/docs-layout/SidebarMenuItem.astro"
import SidebarMenuSub from "@/layouts/docs-layout/SidebarMenuSub.astro"
import SidebarMenuSubButton from "@/layouts/docs-layout/SidebarMenuSubButton.astro"
import SidebarNavChildren from "@/layouts/docs-layout/SidebarNavChildren.astro"
import { buildDocsNav } from "@/layouts/docs-layout/buildDocsNav"

const normalize = (path: string) => path.replace(/\/+$/, "") || "/"
const currentPath = normalize(Astro.url.pathname)

const navMain = await buildDocsNav(currentPath)
---

<aside class="hidden lg:block">
  <div
    class="sticky top-0 h-[calc(100vh-var(--header-height))] w-72 border-r border-border px-6 py-16"
  >
    <SidebarMenu class="flex flex-col gap-8">
      {
        navMain.map((node) =>
          node.kind === "page" ? (
            <SidebarMenuItem>
              <SidebarMenuSubButton href={node.url} isActive={node.isActive}>
                {node.title}
              </SidebarMenuSubButton>
            </SidebarMenuItem>
          ) : (
            <SidebarMenuItem>
              <a href={node.url} class="text-xs font-normal text-foreground/60">
                {node.title}
              </a>
              {node.children.length > 0 ? (
                <SidebarMenuSub class="flex flex-col gap-2">
                  <SidebarNavChildren nodes={node.children} />
                </SidebarMenuSub>
              ) : null}
            </SidebarMenuItem>
          )
        )
      }
    </SidebarMenu>
  </div>
</aside>