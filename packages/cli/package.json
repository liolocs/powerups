{
  "name": "@powerups/cli",
  "version": "0.0.1",
  "author": "lioloc@pm.me",
  "description": "CLI for powerups.dev",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "npm run clean && tsgo && cp src/app.tsconfig.json lib && mkdir -p lib/private/scaffold/templates && cp src/private/scaffold/templates/*.njk lib/private/scaffold/templates/",
    "clean": "rm -rf ./lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build",
    "test": "npx proby",
    "b:link": "bun run scripts/link.ts"
  },
  "type": "module",
  "files": [
    "/lib/**/*.js",
    "/lib/**/*.d.ts",
    "/lib/private/scaffold/*.njk",
    "!/**/*.spec.*"
  ],
  "imports": {
    "#*": {
      "@powerups/source": "./src/private/*.ts",
      "default": "./lib/private/*.js"
    }
  },
  "exports": {
    ".": {
      "@powerups/source": "./src/public/index.ts",
      "default": "./lib/public/index.js"
    }
  },
  "dependencies": {
    "@rcompat/cli": "^0.25.0",
    "@rcompat/error": "^0.9.0",
    "@rcompat/fs": "^0.35.1",
    "@rcompat/io": "^0.11.0",
    "@rcompat/is": "^0.12.0",
    "@rcompat/runtime": "^0.17.0",
    "@rcompat/string": "^0.22.0",
    "@rcompat/type": "^0.18.0",
    "@powerups/program": "workspace:^",
    "nunjucks": "^3.2.4",
    "pema": "^0.8.2"
  },
  "devDependencies": {
    "@types/nunjucks": "^3.2.6"
  },
  "bin": {
    "pup": "./lib/bin.js"
  }
}
